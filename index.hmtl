
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AR Jembatan</title>

  <script type="module"
    src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js">
  </script>

  <style>
    body {
      margin: 0;
      font-family: Arial;
      text-align: center;
      background: #f1f1f1;
    }

    h2 {
      padding: 15px;
    }

    model-viewer {
      width: 100%;
      height: 80vh;
    }

    button {
      background: #1677e8;
      color: white;
      border: none;
      padding: 15px 25px;
      border-radius: 8px;
      font-size: 16px;
    }
  </style>
</head>

<body>

  <h2>Visualisasi AR Jembatan</h2>

  <model-viewer
    src="PBS_baru.glb"
    ar
    ar-modes="scene-viewer webxr"
    ar-scale="fixed"
    camera-controls
    shadow-intensity="1"
    alt="Model Jembatan">

    <button slot="ar-button">
      Tampilkan Jembatan dalam AR
    </button>

  </model-viewer>

</body>
</html>

